# Copy to .env and adjust as needed. docker-compose.yml currently hardcodes
# matching dev defaults directly, so .env is only needed if you run the
# backend/seed binaries outside docker compose (e.g. `go run ./cmd/server`).

APP_ADDR=:8080
APP_DB_HOST=127.0.0.1
APP_DB_PORT=3306
APP_DB_USER=fpanda
APP_DB_PASSWORD=fpanda
APP_DB_NAME=fpanda
# Set to "false" for local HTTP-only development so the browser will accept
# the session cookie; must be "true" (the default) in any real deployment.
APP_COOKIE_SECURE=true
